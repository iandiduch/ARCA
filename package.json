{
  "name": "arca-api",
  "version": "0.1.0",
  "description": "API REST propia de facturación electrónica ARCA para POS multi-tenant",
  "main": "dist/app/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app/bootstrap.js",
    "dev": "tsx watch src/app/bootstrap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts"
  },
  "keywords": [
    "arca",
    "afip",
    "facturacion-electronica",
    "fastify",
    "typescript",
    "multi-tenant",
    "wsaa",
    "wsfev1"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.28",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.2.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
