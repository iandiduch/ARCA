# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arca_db
DATABASE_MAX_CONNECTIONS=10

# Security & Master Access
API_KEY_MASTER=dev-master-secret-key-change-in-production
# 32-byte hex string (64 characters) for encrypting stored private keys at rest (AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ARCA Fiscal Defaults
ARCA_DEFAULT_ENVIRONMENT=homologation
ARCA_PLATFORM_CUIT=20000000001
