# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arca_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Security & Master Access
# En producción, debe ser un secreto criptográfico de al menos 32 caracteres
API_KEY_MASTER=dev-master-secret-key-change-in-production
# Clave hexadecimal de 32 bytes (64 caracteres) para cifrar certificados y claves privadas en reposo (AES-256-GCM)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ARCA Fiscal Defaults
ARCA_DEFAULT_ENVIRONMENT=homologation
ARCA_PLATFORM_CUIT=20000000001

# Rate Limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
