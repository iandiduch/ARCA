# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arca_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Pool separado para bloqueos de emisión por punto de venta y renovación de tickets WSAA
DATABASE_LOCK_MAX_CONNECTIONS=10
# Espera máxima por el turno de emisión de un punto de venta antes de responder 503 RESOURCE_BUSY
FISCAL_LOCK_TIMEOUT_MS=30000

# Security & Master Access
# En producción, debe ser un secreto criptográfico de al menos 32 caracteres
API_KEY_MASTER=dev-master-secret-key-change-in-production
# Clave hexadecimal de 32 bytes (64 caracteres) para cifrar certificados y claves privadas en reposo (AES-256-GCM)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ARCA Fiscal Defaults
ARCA_DEFAULT_ENVIRONMENT=homologation
ARCA_PLATFORM_CUIT=20000000001

# Proxy inverso: "false", "true", cantidad de saltos ("1" detrás de Traefik/Dokploy) o lista de IPs/CIDR
TRUST_PROXY=false

# Rate Limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Email (envío de comprobantes). Sin SMTP_HOST, en producción POST /invoices/:id/email responde 503
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_MAX_SENDS_PER_INVOICE=5
